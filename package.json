{
  "name": "provenance-widgets",
  "version": "2.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web-components": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components/index.js",
      "default": "./dist/web-components/index.js"
    },
    "./web-components/index.js": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components/index.js",
      "default": "./dist/web-components/index.js"
    },
    "./web-components/styles.css": "./dist/web-components/styles.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "preact": "^10.29.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@provenance-widgets/core": "^1.0.0",
    "d3": "^7.9.0",
    "d3-color": "^3.1.0",
    "primereact": "^10.9.7",
    "react-tooltip": "^5.30.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:library && npm run build:web-components",
    "build:library": "tsup",
    "build:web-components": "tsup --config tsup.web-components.config.ts",
    "prepare": "npm run build",
    "prepack": "npm run typecheck",
    "verify": "npm run typecheck && npm run build"
  },
  "author": "Jianheng Ouyang",
  "contributors": ["Antariksh Verma","Kaustubh Odak","Yiyao Tong","Arpit Narechania"],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.6.2"
  }
}
